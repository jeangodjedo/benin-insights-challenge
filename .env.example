# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is gitignored.
#
# Usage:
#   cp .env.example .env
#   then edit .env with your actual values

# Your Google Cloud Project ID
# Visible at console.cloud.google.com (top left navigation bar)
# Format: "project-name-123456"
GCP_PROJECT_ID=your-google-cloud-project-id

# ─────────────────────────────────────────────────────────────────
# BeninSentinel — Configuration SMTP pour envoi réel des bulletins
# ─────────────────────────────────────────────────────────────────
# Si SENTINEL_SMTP_HOST est vide, le provider email passe en mode
# simulé (status="SIMULATED") — aucun email n'est envoyé.
#
# Exemple Brevo (ex-Sendinblue) — 300 emails/jour gratuits :
SENTINEL_SMTP_HOST=smtp-relay.brevo.com
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=acd483001@smtp-brevo.com
SENTINEL_SMTP_PASSWORD=your-brevo-smtp-key-here
SENTINEL_SMTP_USE_TLS=1
SENTINEL_SMTP_FROM_NAME=BeninSentinel
# Adresse expéditrice vérifiée dans Brevo — distincte du SMTP_USER technique.
# Pour Gmail, laisser vide (la valeur de SMTP_USER sera utilisée).
SENTINEL_SMTP_FROM_EMAIL=devpancrace@gmail.com

# Alternative — Gmail (500 emails/jour) :
# SENTINEL_SMTP_HOST=smtp.gmail.com
# SENTINEL_SMTP_PORT=587
# SENTINEL_SMTP_USER=your.email@gmail.com
# SENTINEL_SMTP_PASSWORD=your-16-char-app-password